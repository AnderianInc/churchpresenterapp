{
  "name": "church-presenter",
  "version": "1.0.1",
  "description": "Free offline-first church presentation software",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "wait-on http://localhost:3000 && electron .",
    "electron:dev": "concurrently \"BROWSER=none npm start\" \"npm run electron\"",
    "electron:build": "npm run build-offline-index && npm run update-online-index && npm run build && npm run copy-electron-main && electron-builder",
    "electron:build:win": "npm run build-offline-index && npm run update-online-index && npm run build && npm run copy-electron-main && electron-builder --win --publish never",
    "electron:build:mac": "npm run electron:build:mac:arm64",
    "electron:build:mac:arm64": "npm run build-offline-index && npm run update-online-index && npm run build && npm run copy-electron-main && electron-builder --mac --arm64",
    "copy-electron-main": "node scripts/copy-electron-main.js",
    "electron:build:mac:x64": "echo 'macOS Intel builds are no longer published for this release line.' && exit 1",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "build-offline-index": "node scripts/build-offline-index.js",
    "update-online-index": "node scripts/update-online-index.js"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.2",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.church.churchpresenter",
    "productName": "Church Presenter",
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/notarize.js",
    "copyright": "Copyright © 2024 Church Presenter Contributors",
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "files": [
      "build/**/*",
      "src/data/defaultSongs.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE}",
      "!**/node_modules/.cache",
      "!build/Holy-Bible-XML-Format-master/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "asar": true,
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Church Presenter uses the camera for live streaming.",
        "NSMicrophoneUsageDescription": "Church Presenter uses the microphone for the Sermon Assistant live transcription feature."
      }
    },
    "dmg": {
      "title": "Church Presenter ${version}",
      "contents": [
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 150, "type": "file" }
      ],
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "publisherName": "Church Presenter Contributors",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Church Presenter"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "AudioVideo",
      "description": "Free offline-first church presentation software",
      "maintainer": "Church Presenter Contributors"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
